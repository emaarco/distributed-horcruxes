<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0vze3ke" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:message id="Message_04tc0t0" name="Message_FormSubmitted" />
  <bpmn:message id="Message_36dkcng" name="Message_SubscriptionConfirmed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=subscriptionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="newsletter-subscription" isExecutable="true">
    <bpmn:startEvent id="startEvent_submitRegistrationForm" name="Submit newsletter form">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=subscriptionId" target="subscriptionId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_submitToConfirmation</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0u15bi8" messageRef="Message_04tc0t0" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_submitToConfirmation" sourceRef="startEvent_submitRegistrationForm" targetRef="subProcess_confirmation" />
    <bpmn:subProcess id="subProcess_confirmation" name="Subscription Confirmation">
      <bpmn:incoming>flow_submitToConfirmation</bpmn:incoming>
      <bpmn:outgoing>flow_confirmationToWelcomeMail</bpmn:outgoing>
      <bpmn:startEvent id="startEvent_requestReceived" name="Subscription requested">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=subscriptionId" target="subscriptionId" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>flow_requestToMerge</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="flow_requestToMerge" sourceRef="startEvent_requestReceived" targetRef="gateway_resendReminder" />
      <bpmn:exclusiveGateway id="gateway_resendReminder">
        <bpmn:incoming>flow_requestToMerge</bpmn:incoming>
        <bpmn:incoming>flow_everyDayToMerge</bpmn:incoming>
        <bpmn:outgoing>flow_mergeToConfirmationMail</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="flow_mergeToConfirmationMail" sourceRef="gateway_resendReminder" targetRef="serviceTask_sendConfirmationMail" />
      <bpmn:serviceTask id="serviceTask_sendConfirmationMail" name="Send confirmation mail">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="newsletter.sendConfirmationMail" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow_mergeToConfirmationMail</bpmn:incoming>
        <bpmn:outgoing>flow_confirmationMailToConfirm</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="flow_confirmationMailToConfirm" sourceRef="serviceTask_sendConfirmationMail" targetRef="receiveTask_confirmRegistration" />
      <bpmn:receiveTask id="receiveTask_confirmRegistration" name="Confirm subscription" messageRef="Message_36dkcng">
        <bpmn:incoming>flow_confirmationMailToConfirm</bpmn:incoming>
        <bpmn:outgoing>flow_confirmToConfirmed</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="event_everyDay" name="Every&#10;day" attachedToRef="receiveTask_confirmRegistration">
        <bpmn:outgoing>flow_everyDayToMerge</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_0eef05y">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="flow_everyDayToMerge" sourceRef="event_everyDay" targetRef="gateway_resendReminder" />
      <bpmn:sequenceFlow id="flow_confirmToConfirmed" sourceRef="receiveTask_confirmRegistration" targetRef="endEvent_subscriptionConfirmed" />
      <bpmn:endEvent id="endEvent_subscriptionConfirmed" name="Subscription confirmed">
        <bpmn:incoming>flow_confirmToConfirmed</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_confirmationToWelcomeMail" sourceRef="subProcess_confirmation" targetRef="serviceTask_sendWelcomeMail" />
    <bpmn:boundaryEvent id="event_after3Days" name="After 3&#10;days" attachedToRef="subProcess_confirmation">
      <bpmn:outgoing>flow_after3DaysToAbort</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0tvn6wx">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_after3DaysToAbort" sourceRef="event_after3Days" targetRef="serviceTask_abortRegistration" />
    <bpmn:serviceTask id="serviceTask_abortRegistration" name="Abort registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="newsletter.abortRegistration" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_after3DaysToAbort</bpmn:incoming>
      <bpmn:outgoing>flow_abortToAborted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_abortToAborted" sourceRef="serviceTask_abortRegistration" targetRef="endEvent_registrationAborted" />
    <bpmn:endEvent id="endEvent_registrationAborted" name="Registration aborted">
      <bpmn:incoming>flow_abortToAborted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="serviceTask_sendWelcomeMail" name="Send&#10;Welcome-Mail">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="newsletter.sendWelcomeMail" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_confirmationToWelcomeMail</bpmn:incoming>
      <bpmn:outgoing>flow_welcomeMailToCompleted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_welcomeMailToCompleted" sourceRef="serviceTask_sendWelcomeMail" targetRef="endEvent_registrationCompleted" />
    <bpmn:endEvent id="endEvent_registrationCompleted" name="Registration completed">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=subscriptionId" target="subscriptionId" />
        </zeebe:ioMapping>
        <zeebe:taskDefinition type="newsletter.registrationCompleted" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_welcomeMailToCompleted</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0epolm0" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="newsletter-subscription">
